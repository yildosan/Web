<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mobil Web Tarayıcı</title>
    <style>
        /* Temel Sıfırlama */
        * { 
            box-sizing: border-box; 
            -webkit-tap-highlight-color: transparent;
        }
        
        body { 
            margin: 0; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex; 
            flex-direction: column; 
            height: 100vh; 
            background: #1a1a1a;
            overflow: hidden;
        }

        /* Mobil Uyumlu Üst Panel */
        .toolbar {
            background: #2d2d2d;
            padding: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            z-index: 10;
        }

        /* Butonları mobilde daha büyük ve dokunmatik dostu yaptık */
        .btn {
            background: #3d3d3d;
            border: none;
            color: white;
            font-size: 20px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            flex-shrink: 0;
        }

        .btn:active {
            background: #555;
            transform: scale(0.95);
        }

        /* Adres Çubuğu */
        .address-bar {
            flex-grow: 1;
            padding: 10px 15px;
            border-radius: 25px;
            border: 1px solid #444;
            background: #121212;
            color: #e0e0e0;
            font-size: 14px;
            outline: none;
            width: 100%;
        }

        /* İçerik Alanı (Iframe) */
        .browser-container {
            flex-grow: 1;
            position: relative;
            background: white;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Alt Bilgi (Opsiyonel Mobil Navigasyon) */
        .bottom-bar {
            background: #2d2d2d;
            height: 45px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            border-top: 1px solid #444;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: #4caf50;
            border-radius: 50%;
            margin-right: 5px;
        }
        
        .status-text {
            color: #aaa;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <div class="toolbar">
        <input type="text" id="urlInput" class="address-bar" placeholder="Site adresi girin..." onkeydown="checkEnter(event)">
        <button class="btn" onclick="loadUrl()">➔</button>
    </div>

    <div class="browser-container">
        <iframe id="browserFrame" src="https://www.bing.com"></iframe>
    </div>

    <div class="bottom-bar">
        <button class="btn" style="background:none; font-size: 16px;" onclick="goBack()">◀</button>
        <div style="display: flex; align-items: center;">
            <div class="status-dot"></div>
            <span class="status-text">Canlı</span>
        </div>
        <button class="btn" style="background:none; font-size: 16px;" onclick="reload()">↻</button>
    </div>

    <script>
        const frame = document.getElementById('browserFrame');
        const urlInput = document.getElementById('urlInput');

        function loadUrl() {
            let url = urlInput.value.trim();
            if (url === "") return;
            
            // Eğer protokol yoksa ekle
            if (!url.startsWith('http://') && !url.startsWith('https://')) {
                url = 'https://' + url;
            }
            
            frame.src = url;
            urlInput.value = url; // Temizlenmiş URL'yi geri yaz
            urlInput.blur(); // Mobilde klavyeyi kapatır
        }

        function checkEnter(event) {
            if (event.key === 'Enter') {
                loadUrl();
            }
        }

        function reload() {
            frame.src = frame.src;
        }

        function goBack() {
            // Iframe içi geçmiş bazen güvenlik nedeniyle engellenebilir
            try {
                window.history.back();
            } catch (e) {
                console.error("Geri gidilemedi.");
            }
        }
    </script>
</body>
</html>
